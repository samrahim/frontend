{
  "name": "school-app-desktop",
  "version": "1.0.0",
  "description": "School App - React + Electron Desktop Application",
  "author": {
    "name": "Samai Rahim",
    "email": "rahimsamai92@gmail.com"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build": "npm run build:vite && npm run build:electron",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-build": "npm run build && electron-builder --win",
    "electron-build:linux": "npm run build && electron-builder --linux",
    "type-check": "tsc --noEmit",
    "codegen": "graphql-codegen",
    "codegen:watch": "node scripts/watch-codegen.js",
    "dev:full": "concurrently \"npm run codegen:watch\" \"npm run electron-dev\"",
    "schema": "npx get-graphql-schema http://localhost:8081/query > ./src/graphql/schema.graphql"
  },
  "dependencies": {
    "@apollo/client": "^3.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@tanstack/react-table": "^8.21.3",
    "@theme-ui/core": "^0.17.4",
    "@theme-ui/css": "^0.17.4",
    "apollo-upload-client": "^17.0.0",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.23",
    "electron-is-dev": "^3.0.1",
    "firebase": "^12.16.0",
    "get-graphql-schema": "^2.1.2",
    "graphql": "^16.8.0",
    "graphql-ws": "^6.0.8",
    "i18next": "^26.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-form-stepper": "^2.0.3",
    "react-h5-audio-player": "^3.10.2",
    "react-i18next": "^17.0.2",
    "react-icons": "^5.6.0",
    "react-modal": "^3.16.3",
    "react-phone-input-2": "^2.15.1",
    "react-phone-number-input": "^3.4.16",
    "react-pro-sidebar": "^1.1.0",
    "react-router-dom": "^6.16.0",
    "react-toastify": "^11.1.0",
    "react-use-audio-recorder": "^0.4.2",
    "rrule": "^2.8.1",
    "theme-ui": "^0.17.4",
    "timepicker-ui-react": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-codegen/typescript-react-apollo": "^4.4.1",
    "@parcel/watcher": "^2.5.6",
    "@types/apollo-upload-client": "^17.0.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.0",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^8.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.16",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.school.app",
    "productName": "School App",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "assets/icon.png",
      "maintainer": "Samai Rahim rahimsamai92@gmail.com "
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist/**"
    ],
   "win": {
  "target": ["nsis", "portable", "zip"],
  "icon": "public/icon.ico"
},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
